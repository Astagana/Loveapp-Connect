# Salin file ini menjadi ".env" lalu isi nilainya sebelum menjalankan aplikasi

# Kunci rahasia untuk menandatangani token login (WAJIB diganti dengan string acak yang panjang)
JWT_SECRET=ganti_dengan_string_rahasia_yang_sangat_panjang_dan_acak

# Port server (opsional, default 3000)
PORT=3000

# Nama file database SQLite (opsional)
DB_FILE=loveconnect.db
